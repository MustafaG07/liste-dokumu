{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/playlist.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/playlist",
      "methods": ["POST"],
      "dest": "/api/playlist"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
